  m_Script: {fileID: 11500000, guid: 8834251f23247d949a7310790cbd9e9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleNPC
  firstTimeLines:
  - 'Last Part Folk! '
  - Oh yeah!
  - Lemme tell you one final thing!
  - CONCATENATION!
  - Think of it like beads on a string, yeah?
  - That's called CONCATENATION it just glues them together into one longer string.
  - 'Like: "Hello, " + "World!" becomes "Hello, World!".'
  - Very Basic!
  - Also, as you can see this thing is disabled
  - Go on top of the building on the left!
  repeatLines:
  - .....
  - I won't be accompanying you after this, It's beyond my patrol
  - :(
  textSpeed: 0.001
  useTalkCounter: 1
  timesTalked: 0
