MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 589540979}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8834251f23247d949a7310790cbd9e9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleNPC
  firstTimeLines:
  - Hello Recruit!
  - Say, how did you end up here?
  - ...
  - Not much of a talker aye?
  - 'Aight then. '
  - I got a favor for ya.
  - Since you're already here..
  - I want you to walk up to that green thing and press Q
  - ...
  - Why you might ask?
  - Well you wanna get out of here right?
  - Then do as I said, Mostly the stuff questions are just basic recalling of HTML....
  - HTML?
  - HyperText MarkUp Languange!
  - Though, for some reason the console only accepts ALL CAPITALS
  - So yeah!
  - Basically you need to finish all the console that are placed here, you will know
    when you right the CORRECT answers, when the error time stop moving.
  - Goodluck! might even get a prize :)
  repeatLines:
  - Back again?
  - Question here are most likely just HTML and CSS stuff.
  textSpeed: 0.1
  useTalkCounter: 1
  timesTalked: 0
  dialoguePanel: {fileID: 533680321}
  nameText: {fileID: 1727878173}
  dialogueText: {fileID: 1060842615}
  speakTimeline: {fileID: 1519860241}
  onDialogueOpen:
    m_PersistentCalls:
      m_Calls: []
  onDialogueClose:
    m_PersistentCalls:
      m_Calls: []
