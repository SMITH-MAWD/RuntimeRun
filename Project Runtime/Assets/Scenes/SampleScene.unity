  m_Script: {fileID: 11500000, guid: 60da8a1bbd9691541a1770efb7d1246e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::dialogue
  textComponent: {fileID: 2081264438}
  lines:
  - '>>Hey! Slow down a bit.'
  - 'You: ..?'
  - '>>You''ve learned everything I can teach you!'
  - '>>Once you jump down... It''s all you. Just you and this broken world.'
  - '>> ...you ready?'
  - 'You: Yeah.'
  - '>>Good luck.'
  - '>>Hey I never did catch your name.'
  - 'You: ...Synthia.'
  - '>>See you around Synthia.'
  - 'Synthia: ...'
  textSpeed: 0
