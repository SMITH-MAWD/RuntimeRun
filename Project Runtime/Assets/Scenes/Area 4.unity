  m_EditorClassIdentifier: Assembly-CSharp::dialogue
  textComponent: {fileID: 1856242524}
  lines:
  - '>>Hey! Slow down a bit.'
  - 'You: ..?'
  - '>>You''ve learned everything I can teach you!'
  - '>>Once you jump down... It''s all you. Just you and this broken world.'
  - '>> ...you ready?'
  - 'You: Yeah.'
  - '>>Good luck.'
  - '>>Hey I never did catch your name.'
  - 'You: ...Synthia.'
  - '>>See you around Synthia.'
  - 'Synthia: ...'
  textSpeed: 0
