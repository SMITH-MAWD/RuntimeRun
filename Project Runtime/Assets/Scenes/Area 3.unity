  m_Script: {fileID: 11500000, guid: 8834251f23247d949a7310790cbd9e9d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SimpleNPC
  firstTimeLines:
  - Hmmmm, I wonder where the console hmmmm.....
  - Nah I'm kidding, it's on top of me
  - You could use box to get up there, I wonder where...
  - Hint, Uhm I don't know
  - 'Hmmm I know you''re gonna find this console difficult.... '
  - So I'm a VARIABLE, right?
  - I'm basically a labeled jar JavaScript gives you to stash data. You name me,
    then throw a value in there number, string, boolean!
  - SO! I can hold any type numbers-
  - Strings, booleans, arrays, objects, even other functions.
  - And you can use me to store stuff so you don't keep typing raw values like a
    madman!
  repeatLines:
  - Did ya get it?
  - Tung tung....
  textSpeed: 0.01
  useTalkCounter: 1
  timesTalked: 0
  dialoguePanel: {fileID: 323140508}
  nameText: {fileID: 472711795}
